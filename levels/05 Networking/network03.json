		{
			type:"packet", device:"Alice",
			payload:{application:{type:"acknowledge", key:"192.0.2.10"}}
		},
		{
			type:"packet", device:"Web Server",
			payload:{
				network:{srcip:"192.0.2.10", dstip:"Web Server"},
				application:{type:"web-request"}
			}
		}
	]
