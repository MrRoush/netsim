{
	devices:[
		{id:"Alice", image:"imac", ports:1, x:0.12, y:0.5, player:true},
		{
			id:"Router", image:"router", ports:3, x:0.42, y:0.5,
			script:deviceScripts.manualRouter,
			rules:[
				{dstip:"Alice", portNum:0},
				{dstip:"192.0.2.10", portNum:0},
				{dstip:"DHCP Server", portNum:1},
				{dstip:"Web Server", portNum:2}
			]
		},
		{id:"DHCP Server", image:"server", ports:1, x:0.7, y:0.3, script:deviceScripts.dhcp},
		{id:"Web Server", image:"server", ports:1, x:0.7, y:0.7}
	],
	links:[
		{src:"Alice", srcport:0, dst:"Router", dstport:0},
		{src:"Router", srcport:1, dst:"DHCP Server", dstport:0},
		{src:"Router", srcport:2, dst:"Web Server", dstport:0}
	],
	timeline:[
		{
			type:"packet", at:500, from:"Alice",
			payload:{
				network:{srcip:"Alice", dstip:"DHCP Server"},
				transport:{proto:"DHCP"},
				application:{type:"discover", key:""}
